  "components": {
    "schemas": {
      "ConfigField": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "path",
              "password",
              "folder"
            ],
            "title": "Kind"
          },
          "required": {
            "type": "boolean",
            "title": "Required"
          },
          "hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hint"
          },
          "placeholder": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Placeholder"
          }
        },
        "type": "object",
        "required": [
          "name",
          "label",
          "kind",
          "required"
        ],
        "title": "ConfigField"
      },
      "ConfigSchema": {
        "properties": {
          "fields": {
            "items": {
              "$ref": "#/components/schemas/ConfigField"
            },
            "type": "array",
            "title": "Fields"
          }
        },
        "type": "object",
        "required": [
          "fields"
        ],
        "title": "ConfigSchema"
      },
      "ConnectorInfo": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "ready": {
            "type": "boolean",
            "title": "Ready"
          },
          "config_schema": {
            "$ref": "#/components/schemas/ConfigSchema"
          }
        },
        "type": "object",
        "required": [
          "type",
          "ready",
          "config_schema"
        ],
        "title": "ConnectorInfo"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImportEnqueueOut": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          }
        },
        "type": "object",
        "required": [
          "task_id"
        ],
        "title": "ImportEnqueueOut"
      },
      "ImportStatusOut": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "progress": {
            "type": "integer",
            "title": "Progress"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "status",
          "progress",
          "error"
        ],
        "title": "ImportStatusOut"
      },
      "LastImportOut": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          }
        },
        "type": "object",
        "required": [
          "status",
          "finished_at"
