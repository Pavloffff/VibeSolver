VIBESOLVER_MATERIAL_GENERATION_TIMEOUT_SECONDS=180
VIBESOLVER_MATERIAL_GENERATION_MAX_OUTPUT_TOKENS=8192
VIBESOLVER_MATERIAL_GENERATION_CONTEXT_CHUNKS=24
VIBESOLVER_MATERIAL_GENERATION_MAX_CONTEXT_CHARACTERS=48000
VIBESOLVER_MATERIAL_GENERATION_MAX_FILES=12
VIBESOLVER_MATERIAL_GENERATION_MAX_FILE_BYTES=200000
